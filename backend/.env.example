# Copiar a .env para desarrollo local. Nunca subir .env al repositorio.
DJANGO_DEBUG=True
# Generar con: python3 -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL local (docker compose up -d). Sin esta línea se usa SQLite.
DATABASE_URL=postgres://evaluacion:evaluacion@localhost:5433/evaluacion
